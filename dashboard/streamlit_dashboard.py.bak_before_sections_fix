def get_clickhouse_config():
    """Return ClickHouse connection configuration.

    Do not perform a separate health-check query here. The actual dashboard
    query will validate connectivity and expose its own ClickHouse error.
    """
    CH_HOST = os.getenv("CLICKHOUSE_HOST", "localhost")
    CH_PORT = int(os.getenv("CLICKHOUSE_PORT", "8123"))
    CH_DB = os.getenv("CLICKHOUSE_DB", "eurocrimepulse")
    CH_USER = os.getenv("CLICKHOUSE_USER", None)
    CH_PASS = os.getenv("CLICKHOUSE_PASSWORD", None)

    return {
        "host": CH_HOST,
        "port": CH_PORT,
        "db": CH_DB,
        "user": CH_USER,
        "pass": CH_PASS,
    }


def _qualify_table_names(sql: str) -> str:
    """Qualify plain table names (e.g., dim_date) with the ClickHouse DB schema (eurocrimepulse).

    Only unqualified identifiers are rewritten (does not touch already qualified names).
    """
    cfg = get_clickhouse_config()
    db = cfg["db"]
    out = sql
    for t in TABLES:
        # Replace occurrences of the bare table name that are not already prefixed with a dot
        pattern = rf"(?<![\.\w])\b{re.escape(t)}\b"
        out = re.sub(pattern, f"{db}.{t}", out)
    return out


def q(sql: str) -> pd.DataFrame:
    """Execute SQL against ClickHouse HTTP using GET, matching the verified curl path."""
    cfg = get_clickhouse_config()
    full_sql = _qualify_table_names(sql)

    if "FORMAT" not in full_sql.upper():
        full_sql = full_sql.rstrip() + " FORMAT JSON"

    auth = (cfg["user"], cfg["pass"]) if cfg["user"] else None
    url = f"http://{cfg['host']}:{cfg['port']}/"

    try:
        resp = requests.get(
            url,
            params={"query": full_sql},
            timeout=30,
            auth=auth,
        )
        resp.raise_for_status()
        payload = resp.json()
    except Exception as exc:
        st.error(f"ClickHouse query failed: {exc}")
        st.code(full_sql)
        try:
            st.code(resp.text)
        except Exception:
            pass
        return pd.DataFrame()

    data = payload.get("data", [])

    if not data:
        cols = [m["name"] for m in payload.get("meta", [])]
        df = pd.DataFrame(columns=cols)
    else:
        df = pd.DataFrame(data)

    return df


