        release_joins += """
          ANY INNER JOIN dim_crime_type ct
            ON f.crime_type_key = ct.crime_type_key
        """
        release_conditions.append(
            f"ct.crime_type IN ({sql_list(crime_types)})"
        )

    if countries or cities:
        release_joins += """
          ANY INNER JOIN dim_city ci
            ON f.city_key = ci.city_key
        """

        if countries:
            release_conditions.append(
                f"ci.country_name IN ({sql_list(countries)})"
            )

        if cities:
            release_conditions.append(
                f"ci.city_name IN ({sql_list(cities)})"
            )

    release_where = " AND ".join(release_conditions)

    reltrend = q(f"""
      SELECT
          rd.year,
          rd.month,
          rd.month_name,
          uniqExact(f.crime_case_key) AS released_cases
      {release_joins}
      WHERE {release_where}
      GROUP BY
          rd.year,
          rd.month,
          rd.month_name
      ORDER BY
          rd.year,
          rd.month
    """)

    required_release_cols = {
        "year",
        "month",
        "month_name",
        "released_cases",
    }

    if (
        reltrend.empty
        or not required_release_cols.issubset(reltrend.columns)
    ):
        st.info(
            "No release-trend data is available "
            "for the current filters."
        )
    else:
        reltrend = reltrend.copy()

        reltrend["year"] = pd.to_numeric(
            reltrend["year"],
            errors="coerce",
        )
        reltrend["released_cases"] = pd.to_numeric(
            reltrend["released_cases"],
            errors="coerce",
        )

        reltrend = reltrend.dropna(
            subset=[
                "year",
                "month_name",
                "released_cases",
            ]
        )

        if reltrend.empty:
            st.info(
                "No release-trend data is available "
                "for the current filters."
            )
        else:
            fig = px.line(
                reltrend,
                x="month_name",
                y="released_cases",
                color="year",
                markers=True,
                color_discrete_sequence=[
                    RED,
                    NAVY,
                    GOLD,
                    BLUE,
                    GREEN,
                ],
                category_orders={
                    "month_name": MONTH_ORDER
                },
                labels={
                    "month_name": "Month",
                    "released_cases": "Released Cases",
                    "year": "Year",
                },
            )

            fig.update_traces(
                line=dict(width=3),
                hovertemplate=(
                    "Year: %{fullData.name}<br>"
                    "Month: %{x}<br>"
                    "Released Cases: %{y:,}"
                    "<extra></extra>"
                ),
            )

            show_chart(
                fig,
                570,
                legend=True,
                hover="x unified",
            )

    st.markdown("###  Victim vs Defendant Average Age")
    demo = q(f"""
      WITH case_level AS (
        SELECT
            crime_case_key,
            any(crime_type_key) AS crime_type_key,
            any(city_key) AS city_key,
            any(crime_date_key) AS crime_date_key,
            any(victim_key) AS victim_key,
            any(defendant_key) AS defendant_key
        FROM fact_crime_case
        GROUP BY crime_case_key
      )
      SELECT
          ct.crime_type,
          ROUND(AVG(v.victim_age), 1) AS avg_victim_age,
          ROUND(AVG(de.defendant_age), 1) AS avg_defendant_age
      FROM case_level f
      ANY INNER JOIN dim_crime_type ct
        ON f.crime_type_key = ct.crime_type_key
      ANY INNER JOIN dim_city ci
        ON f.city_key = ci.city_key
      ANY INNER JOIN dim_date d
        ON f.crime_date_key = d.date_key
      ANY INNER JOIN dim_victim v
        ON f.victim_key = v.victim_key
      ANY INNER JOIN dim_defendant de
        ON f.defendant_key = de.defendant_key
      {WHERE}
      GROUP BY ct.crime_type
      ORDER BY avg_victim_age DESC
    """)
    if not demo.empty:
        long = demo.melt(
            id_vars="crime_type",
            value_vars=["avg_victim_age", "avg_defendant_age"],
            var_name="group", value_name="age"
        )
        long["group"] = long["group"].map({
            "avg_victim_age": "Victim",
            "avg_defendant_age": "Defendant"
        })
        fig = px.bar(
            long, x="crime_type", y="age", color="group", barmode="group",
            color_discrete_sequence=[RED, NAVY],
            labels={"crime_type": "", "age": "Average Age", "group": ""},
        )
        fig.update_xaxes(tickangle=-35)
        show_chart(fig, 570, legend=True)

    st.markdown("###  Key Insights")
    if (
        isinstance(rates, pd.DataFrame)
        and not rates.empty
        and "crime_type" in rates.columns
        and "imprisonment_rate_pct" in rates.columns
    ):
