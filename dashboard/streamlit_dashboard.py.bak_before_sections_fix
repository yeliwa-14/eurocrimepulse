def q_scalar(sql, default=None):
    """Return the first cell of a query safely."""
    df = q(sql)
    if df is None or df.empty or df.shape[1] == 0:
        return default
    try:
        return df.iloc[0, 0]
    except Exception:
        return default

def sql_list(values):
    if values is None:
        return ""

    if isinstance(values, (str, int, float)):
        values = [values]

    return ", ".join(
        "'" + str(v).replace("'", "''") + "'"
        for v in values
    )


def filters_sql(years, crime_types, countries, cities, date_alias="d"):
    """Build a safe WHERE clause for the common crime-date filters."""
    clauses = []
    if years:
        clauses.append(f"{date_alias}.year IN ({', '.join(map(str, years))})")
    if crime_types:
        clauses.append(f"ct.crime_type IN ({sql_list(crime_types)})")
    if countries:
        clauses.append(f"ci.country_name IN ({sql_list(countries)})")
    if cities:
        clauses.append(f"ci.city_name IN ({sql_list(cities)})")
    return "WHERE " + " AND ".join(clauses) if clauses else ""


def add_condition(where_clause, condition):
    return f"{where_clause} AND {condition}" if where_clause else f"WHERE {condition}"


def layout(fig, height=500, legend=True, hover="closest"):
    fig.update_layout(
        height=height,
        paper_bgcolor=CARD,
        plot_bgcolor=CARD,
        font=dict(color=TEXT, family="Arial"),
        margin=dict(l=55, r=30, t=50, b=50),
        hovermode=hover,
        showlegend=legend,
        legend=dict(orientation="h", yanchor="bottom", y=1.01, xanchor="left", x=0),
    )
    fig.update_xaxes(showgrid=True, gridcolor=GRID, zeroline=False)
    fig.update_yaxes(showgrid=False, zeroline=False)
    return fig



