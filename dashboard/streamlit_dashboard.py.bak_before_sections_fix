        low_rate = rates.iloc[-1]
        insight(
            "Highest imprisonment rate",
            f"<b>{high_rate.crime_type}</b> has the highest imprisonment rate at <b>{high_rate.imprisonment_rate_pct:.2f}%</b>."
        )
        insight(
            "Lowest imprisonment rate",
            f"<b>{low_rate.crime_type}</b> has the lowest imprisonment rate at <b>{low_rate.imprisonment_rate_pct:.2f}%</b>."
        )
    if not release.empty:
        r = release.iloc[0]
        insight(
            "Most common release reason",
            f"<b>{r.release_reason}</b> is the most frequent release reason with <b>{int(r.released_cases):,} cases</b>."
        )
