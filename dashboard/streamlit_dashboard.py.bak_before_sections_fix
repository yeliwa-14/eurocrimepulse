def _as_float_list(values):
    out = []
    for v in values:
        try:
            out.append(float(v))
        except Exception:
            out.append(0.0)
    return out


def _format_int_labels(values):
    return [f"{int(round(float(v))):,}" for v in values]


def _format_pct_labels(values, decimals=1):
    out = []
    for v in values:
        try:
            out.append(f"{float(v):.{decimals}f}%")
        except Exception:
            out.append("")
    return out


def show_chart(fig, height=500, legend=True, hover="closest"):
    global _chart_counter
    _chart_counter += 1

    fig = layout(fig, height, legend=legend, hover=hover)

    # Do not use texttemplate here.
    # Labels are preformatted in each chart as plain strings.
    st.plotly_chart(
        fig,
        key=f"plotly_chart_{_chart_counter}",
    )

    st.markdown(
        '<div class="chart-gap"></div>',
        unsafe_allow_html=True,
    )


